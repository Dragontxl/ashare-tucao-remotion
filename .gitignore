# 依赖
node_modules/
build/
__pycache__/
*.pyc

# 运行时生成物（每次运行覆盖）
public/charts/
public/voiceover.mp3
src/audio/
src/market_data/
src/sentences.json
src/timeline.json
src/cover.json
src/meta.json
out/*.mp4
out/*.txt
out/*.png
out/*.md
out/bilibili_work/
out/_bundle/
out/_segments/
out/_test/
out/runs/
stills/

# B站 Cookie（含登录凭据，禁止入库）
config/bilibili_cookies.json

# 本地真实配置（含 LLM API Key，禁止入库；请用 config.example.json 为模板）
config/config.json
src/config.json

# 诊断/测试产物
out/_diag/
out/_upload_test/
out/bilibili_result.json

# Web 控制台运行数据
web/data/

# 保留目录
!public/charts/.gitkeep
!out/.gitkeep

# 系统/编辑器
.DS_Store
.env
*.log

# Wrangler 本地状态
worker/.wrangler/

# 股票列表缓存（运行时下载，可过期）
scripts/data/

README.md
